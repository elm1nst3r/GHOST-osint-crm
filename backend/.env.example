# Application Configuration
# NODE_ENV=production makes the session cookie Secure (HTTPS-only). Serve the
# app over HTTPS in production or login cookies are silently dropped. Use a
# non-production value for HTTP-only local/internal testing.
NODE_ENV=development
PORT=3001

# Security
# Add JWT_SECRET for future authentication implementation
# JWT_SECRET=your-secret-key-here

# API Keys (if needed for external services)
# GEOCODING_API_KEY=your-api-key-here
