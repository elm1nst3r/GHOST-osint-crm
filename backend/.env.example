# Environment for running the backend WITHOUT Docker (see "Manual Setup" in the
# README). For the Docker setup use the .env.example in the repository root.
#
# The backend does not read this file by itself — load it into the shell first:
#   set -a; . ./.env; set +a; npm start

# Database
DB_USER=postgres
# REQUIRED: the password of the PostgreSQL role above.
DB_PASSWORD=
DB_NAME=osint_crm_db
DB_HOST=localhost
DB_PORT=5432

# Application
# NODE_ENV=production makes the session cookie Secure (HTTPS-only). Serve the
# app over HTTPS in production or login cookies are silently dropped. Use a
# non-production value for HTTP-only local/internal testing.
NODE_ENV=development
PORT=3001

# REQUIRED: at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Origin the frontend is served from (used for CORS). `npm start` in frontend/
# serves on port 3000.
FRONTEND_URL=http://localhost:3000

# Interactive API reference at /api/docs (signed-in users only).
# API_DOCS_ENABLED=true
