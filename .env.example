# Database Configuration
#
# By default docker-compose.yml starts a bundled PostgreSQL container
# (DB_HOST=db is that container's name on the compose network). To use your
# own PostgreSQL server instead, set DB_HOST/DB_PORT below to it and uncomment
# the COMPOSE_FILE line — the bundled container then never starts, and you're
# responsible for its backups/monitoring yourself.
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml
DB_USER=postgres
# REQUIRED: Set a strong random password. Generate with: openssl rand -base64 24
DB_PASSWORD=
DB_NAME=osint_crm_db
DB_HOST=db
DB_PORT=5432

# Application Configuration
# NODE_ENV=production marks the session cookie as Secure, so the app MUST be
# served over HTTPS in production or login cookies are silently dropped
# (login returns 200 but you stay logged out). Terminate TLS at a reverse
# proxy in front of the container. Use a non-production value for HTTP-only
# local/internal testing. See "Security Considerations" in the README.
NODE_ENV=development
PORT=3001

# Security
# REQUIRED: Minimum 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# The backend's own port (3001) is published on localhost only; everything
# else, including an MCP server on another machine, uses the app's port:
# http://<server>:8080/api. To publish 3001 on the network anyway:
# BACKEND_BIND=0.0.0.0

# The address users open GHOST at. Used for CORS (required in production)
# and as the address passkeys are tied to.
FRONTEND_URL=http://localhost:8080

# Passkeys (two-step sign-in) work only at the address in FRONTEND_URL, and
# only over HTTPS with a domain name, or on localhost; never on an IP address.
# Reached under more than one name? List the others, comma-separated:
# PASSKEY_ORIGINS=https://ghost.example.org,https://osint.example.net

# Interactive API reference at /api/docs (signed-in users only). Set to false
# to remove the page; /api/openapi.json is unaffected.
# API_DOCS_ENABLED=true

# Uploaded files (issue #97): largest accepted upload, in bytes (default 50 MB).
# Above 100 MB also raise client_max_body_size for /api/files in
# frontend/nginx.conf. The files themselves live in the `files_data` volume.
# FILES_MAX_BYTES=52428800

# Integrated OSINT tools (issue #96). API keys are encrypted with a key
# derived from SECRETS_KEY, or SESSION_SECRET when this is unset. Set it if
# you want to rotate SESSION_SECRET without having to re-enter every API key.
# SECRETS_KEY=
# Allow integrations to reach private/LAN addresses (off by default).
# INTEGRATIONS_ALLOW_PRIVATE=false

# Geocoding — Photon runs as a Docker service, no config needed.
# Override only if running Photon separately.
# PHOTON_URL=http://photon:2322

# Add JWT_SECRET for future authentication implementation
# JWT_SECRET=your-secret-key-here

# API Keys (if needed for external services)
# GEOCODING_API_KEY=your-api-key-here

# ── Single sign-on (OpenID Connect, issue #105) ─────────────────────────────
# Off unless OIDC_ENABLED=true. See USER_MANAGEMENT.md → Single sign-on.
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/ghost
# OIDC_CLIENT_ID=ghost
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=https://ghost.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_DISPLAY_NAME=Keycloak
# OIDC_AUTO_PROVISION=false      # true: create a GHOST user on first sign-in
# OIDC_ADMIN_GROUP=ghost-admins  # members become administrators
# OIDC_GROUPS_CLAIM=groups
# OIDC_LOGOUT=true               # signing out of GHOST also signs out at the provider
# LOCAL_LOGIN_ENABLED=true       # GHOST passwords; keep as a fallback
